{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "break",
                "continue",
                "declare",
                "return",
                "throw",
                "try"
            ]
        },
        "concat_space": {
            "spacing": "one"
        },
        "declare_strict_types": true,
        "explicit_string_variable": true,
        "fully_qualified_strict_types": {
            "import_symbols": true
        },
        "method_argument_space": {
            "on_multiline": "ensure_fully_multiline"
        },
        "new_with_parentheses": true,
        "no_superfluous_phpdoc_tags": {
            "allow_mixed": true,
            "allow_unused_params": false,
            "remove_inheritdoc": false
        },
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "destruct",
                "magic",
                "phpunit",
                "method_public",
                "method_protected",
                "method_private"
            ]
        },
        "ordered_imports": {
            "imports_order": [
                "const",
                "class",
                "function"
            ],
            "sort_algorithm": "alpha"
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "arrays",
                "match",
                "parameters"
            ]
        }
    }
}
