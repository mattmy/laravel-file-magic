{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mattmy/laravel-file-magic",
    "description": "A strongly typed file management package for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "guzzlehttp/psr7": "^2.7",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/http-message": "^1.1|^2.0",
        "symfony/http-foundation": "^7.0|^8.0",
        "symfony/mime": "^7.0|^8.0"
    },
    "require-dev": {
        "intervention/image": "^4.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "ext-curl": "Required only when importing files from HTTP(S) URLs.",
        "ext-zip": "Required only when creating ZIP downloads.",
        "intervention/image": "Required only when using image resizing and encoding."
    },
    "conflict": {
        "intervention/image": "<4.0"
    },
    "autoload": {
        "psr-4": {
            "Mattmy\\FileMagic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mattmy\\FileMagic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mattmy\\FileMagic\\FileMagicServiceProvider"
            ],
            "aliases": {
                "FileMagic": "Mattmy\\FileMagic\\Facades\\FileMagic"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "composer validate --strict",
            "@test",
            "@analyse",
            "@format:check",
            "composer audit"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
